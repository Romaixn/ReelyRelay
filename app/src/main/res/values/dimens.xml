<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- How many lines an action row's title and description may wrap to - see themes.xml. -->
    <integer name="action_title_max_lines">2</integer>
    <integer name="action_description_max_lines">4</integer>

    <!--
        Overrides leanback's own value (same resource name): it draws an
        action row's description at 50% alpha, on top of whatever text color
        the theme gives it. The muted color in themes.xml is already the
        intended final tone, so the extra fade is switched off.
    -->
    <item name="lb_guidedactions_item_unselected_description_text_alpha" format="float" type="dimen" tools:override="true" tools:ignore="UnusedResources">1.0</item>
</resources>
