<?xml version="1.0" encoding="utf-8"?>
<!--
    The left-hand panel of every screen: an optional image (the app tile, or
    a QR code), a small breadcrumb, the title, and the explanation.

    Replaces leanback's own lb_guidance layout (see RelayGuidanceStylist),
    which caps the explanation at six lines and puts the image beside the
    text, squeezing both. The four ids are leanback's: GuidanceStylist looks
    its views up by them.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@id/guidance_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="56dp"
    android:paddingTop="32dp"
    android:paddingEnd="48dp"
    android:paddingBottom="48dp">

    <ImageView
        android:id="@id/guidance_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:adjustViewBounds="true"
        android:maxWidth="200dp"
        android:maxHeight="200dp"
        android:scaleType="fitStart"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@id/guidance_breadcrumb"
        style="@style/Widget.ReelyRelay.GuidanceBreadcrumb" />

    <TextView
        android:id="@id/guidance_title"
        style="@style/Widget.ReelyRelay.GuidanceTitle" />

    <TextView
        android:id="@id/guidance_description"
        style="@style/Widget.ReelyRelay.GuidanceDescription" />

</LinearLayout>
